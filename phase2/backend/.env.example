# Backend API Configuration for Local Development

# Database URL for local development (e.g., SQLite)
# For PostgreSQL, use: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL="sqlite:///./test.db"

# CORS origins for local development (comma-separated list)
# Example: http://localhost:3000,https://your-frontend-dev-url.com
_CORS_ORIGINS_STR="http://localhost:3000,http://localhost:3001"

# Port for the backend API
PORT=8000

# Log level (e.g., INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL="DEBUG"
